{
  "name": "pulp-ui",
  "dockerComposeFile": "./docker-compose.yml",
  "service": "pulp-ui",
  "workspaceFolder": "/workspace",
  "forwardPorts": [
    8002
  ],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "initializeCommand": "bash ${localEnv:DEVTOOLS_CARLOSTHE19916_PATH:~/git/devtools}/devcontainer/github.com/pulp/pulp-ui/.devcontainer/initializeCommand.sh ${devcontainerId}",
  "postCreateCommand": "bash /tmp/postCreateCommand.sh ${devcontainerId}",
  "customizations": {
    "vscode": {
      "extensions": [
        "eamodio.gitlens",
        "dsznajder.es7-react-js-snippets",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "git.alwaysSignOff": true
      }
    }
  }
}