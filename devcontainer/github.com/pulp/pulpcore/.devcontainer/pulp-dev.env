# Pulp overrides for local pulpcore compose.
# Compose-specific DB/Redis hosts are set in docker-compose.yml.
# Functional tests (incl. certguard client certs) hit API/content directly,
# matching pulp_plugin_template shared/settings.py + smash on 24817/24816.

PULP_API_ROOT=/pulp/
PULP_DB_ENCRYPTION_KEY=/etc/pulp/certs/database_fields.symmetric.key
PULP_CACHE_ENABLED=true
PULP_DOMAIN_ENABLED=false
PULP_TOKEN_AUTH_DISABLED=true
PULP_WORKER_TYPE=redis
PULP_WORKERS=2
PULP_TASK_DIAGNOSTICS=['memory','memray','pyinstrument']
PULP_ALLOWED_CONTENT_CHECKSUMS=["sha224","sha256","sha384","sha512"]
PULP_CONTENT_PATH_PREFIX=/api/pulp-content/
PULP_CONTENT_ORIGIN=http://localhost:24816
PULP_PYPI_API_HOSTNAME=http://localhost:24817
PULP_PYPI_PATH_PREFIX=/pypi/
PULP_DISTRIBUTED_PUBLICATION_RETENTION_PERIOD=5
PULP_ALLOWED_IMPORT_PATHS=["/tmp"]
PULP_ALLOWED_EXPORT_PATHS=["/tmp"]
