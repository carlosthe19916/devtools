From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pulp-service <pulp-service@redhat.com>
Date: Mon, 28 Jul 2026 00:00:00 +0000
Subject: [PATCH] Fix handle_attestations None user in task context

When a PythonPackageContent is created with attestations, the
serializer's handle_attestations() runs inside a Pulp task where
get_current_authenticated_user() returns None. Calling get_prn(None)
raises "instance(None) must be a Model". Guard against this.

---
 pulp_python/app/serializers.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/pulp_python/app/serializers.py b/pulp_python/app/serializers.py
index 0000001..0000002 100644
--- a/pulp_python/app/serializers.py
+++ b/pulp_python/app/serializers.py
@@ -396,7 +396,8 @@ class PythonPackageContentSerializer(SingleArtifactContentUploadSerializer):
     def handle_attestations(self, filename, sha256, attestations, offline=True):
         """Handle converting attestations to a Provenance object."""
         user = get_current_authenticated_user()
-        publisher = AnyPublisher(kind="Pulp User", prn=get_prn(user))
+        prn = get_prn(user) if user else ""
+        publisher = AnyPublisher(kind="Pulp User", prn=prn)
         att_bundle = AttestationBundle(publisher=publisher, attestations=attestations)
         provenance = Provenance(attestation_bundles=[att_bundle])
         try:
--
