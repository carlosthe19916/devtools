# ClowdApp-like Pulp overrides for local compose (aligned with pulp-docs config/dev-env.env).
# Compose-specific DB/Redis hosts are set in docker-compose.yml.

PULP_API_ROOT=/api/pulp/
PULP_DB_ENCRYPTION_KEY=/etc/pulp/certs/database_fields.symmetric.key
PULP_CACHE_ENABLED=true
PULP_DOMAIN_ENABLED=true
PULP_TOKEN_AUTH_DISABLED=true
PULP_WORKER_TYPE=redis
PULP_WORKERS=2
PULP_ALLOWED_CONTENT_CHECKSUMS=["sha224","sha256","sha384","sha512"]
PULP_CONTENT_PATH_PREFIX=/api/pulp-content/
PULP_CONTENT_ORIGIN=http://localhost:80
PULP_STATIC_URL=/api/pulp/assets/
# Functional attestation tests sign with the generated test keypair (see Dockerfile).
# Production / pulp-docs use the vendored Sigstore PEM at /etc/pki/sigstore/SIGSTORE-redhat-release3.
PULP_ATTESTATION_VERIFICATION_KEY=/etc/pki/attestation/test-key.pem
PULP_FEATURE_SERVICE_API_CERT_PATH=/etc/pulp/certs/pulp-services-non-prod.pem
PULP_OTEL_ENABLED=false
# ModelBackend + Session/Basic before RH JSON-header authenticators so unit tests
# that pre-set request.user (and set HTTP_X_RH_IDENTITY="") still authenticate via
# SessionAuthentication. RHServiceAccountCert first raises 401 on an empty identity
# header (Invalid JSON) before Session can run — that broke create-domain unit tests.
PULP_AUTHENTICATION_BACKENDS=@merge ['django.contrib.auth.backends.RemoteUserBackend','django.contrib.auth.backends.ModelBackend','pulp_service.app.authentication.RHSamlAuthentication']
PULP_REST_FRAMEWORK__DEFAULT_AUTHENTICATION_CLASSES=['rest_framework.authentication.BasicAuthentication','rest_framework.authentication.SessionAuthentication','pulp_service.app.authentication.RHServiceAccountCertAuthentication','pulp_service.app.authentication.RHTermsBasedRegistryAuthentication']
PULP_REST_FRAMEWORK__DEFAULT_PERMISSION_CLASSES=['pulp_service.app.authorization.DomainBasedPermission']
PULP_AUTHENTICATION_JSON_HEADER=HTTP_X_RH_IDENTITY
PULP_AUTHENTICATION_JSON_HEADER_JQ_FILTER=.identity.user.username
PULP_AUTHENTICATION_JSON_HEADER_OPENAPI_SECURITY_SCHEME=@json {"type": "oauth2", "description": "External OAuth2 integration", "flows": { "clientCredentials": { "tokenUrl": "https://sso.stage.redhat.com/auth/realms/redhat-external/protocol/openid-connect/token", "scopes": {"api.console": "grant_access_to_pulp"}}}}
PULP_MIDDLEWARE=@merge ['pulp_service.app.middleware.TrueClientIPMiddleware','pulp_service.app.middleware.RequestPathMiddleware','pulp_service.app.middleware.ActiveConnectionsMetricMiddleware','pulp_service.app.middleware.ProfilerMiddleware','pulp_service.app.middleware.RhEdgeHostMiddleware','pulp_service.app.middleware.RHSamlAuthHeaderMiddleware']
PULP_TASK_PROTECTION_TIME=20160
PULP_TASK_DIAGNOSTICS=['memory','memray','pyinstrument']
PULP_UPLOAD_PROTECTION_TIME=480
PULP_MAX_CONCURRENT_CONTENT=200
PULP_PYTHON_GROUP_UPLOADS=true
PULP_PYPI_API_HOSTNAME=http://localhost:80
PULP_PYPI_PATH_PREFIX=/api/pypi/
