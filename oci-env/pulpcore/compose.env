# : separated list of profiles to use. Ex: galaxy_ng/ui:ha
COMPOSE_PROFILE=pulpcore/pycharm
COMPOSE_PROJECT_NAME=pulpcore

# : separate list of python dependencies to include from source
DEV_SOURCE_PATH=pulpcore:pulp_python:pulp_npm

# Program to use for compose. This defaults to podman. Uncomment this to use docker-compose.
# COMPOSE_BINARY=docker

# Set any custom pulp settings by adding environment variables with the PULP_ prefix
# PULP_MY_SETTING....

# Enable the content cache backed by the in-container Redis (valkey on 127.0.0.1:6379).
# Lets the If-Modified-Since Redis-path tests run instead of skipping.
PULP_CACHE_ENABLED="True"
PULP_REDIS_HOST=127.0.0.1
PULP_REDIS_PORT=6379

# Dev-only: allow anonymous access to the Pulp REST API (no admin:password).
PULP_REST_FRAMEWORK__DEFAULT_PERMISSION_CLASSES='@json ["rest_framework.permissions.AllowAny"]'
PULP_DOMAIN_ENABLED="True"
PULP_API_ROOT="/api/pulp/"

# Django admin user credentials that gets created during startup
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=password

# Port, hostname and protocol used to configure pulp content origin
API_HOST=localhost
API_PORT=5001
API_PROTOCOL=http

# Django SECRET_KEY value, used for session auth - uncomment this and change the value to something else
PULP_SECRET_KEY="dev_changeme_notasecret"
